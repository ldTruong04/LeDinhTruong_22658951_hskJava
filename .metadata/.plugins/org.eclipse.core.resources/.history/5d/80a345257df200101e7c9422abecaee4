package Tuan1;

import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class SoNguyenTo extends JFrame {
    private JTextField txtN;
    private JTextArea areaResult;
    private JButton btnGenerate;

    public SoNguyenTo() {
        
        setTitle("Primes");
        setSize(400, 300);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        // Panel chứa Input và Button
        JPanel pnlTop = new JPanel(new FlowLayout());
        txtN = new JTextField(15);
        btnGenerate = new JButton("Generate");
        pnlTop.add(txtN);
        pnlTop.add(btnGenerate);
        add(pnlTop, BorderLayout.NORTH);

        // hiển kết quả 
        areaResult = new JTextArea();
        areaResult.setEditable(false); // Không cho chỉnh sửa 
        JScrollPane scrollPane = new JScrollPane(areaResult);
        add(scrollPane, BorderLayout.CENTER);

        // Xử lý sự kiện
        btnGenerate.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                generatePrimes();
            }
        });
    }

    private void generatePrimes() {
        try {
            int n = Integer.parseInt(txtN.getText());
            if (n <= 0) {
                JOptionPane.showMessageDialog(this, "Vui lòng nhập số nguyên dương N > 0");
                return;
            }

            StringBuilder sb = new StringBuilder();
            int count = 0;
            int number = 2; 

            while (count < n) {
                if (isPrime(number)) {
                    sb.append(number).append("\n");
                    count++;
                }
                number++;
            }
            areaResult.setText(sb.toString());

        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Giá trị nhập vào phải là một số nguyên!");
        }
    }

    // Hàm kiểm tra số nguyên tố
    private boolean isPrime(int n) {
        if (n < 2) return false;
        for (int i = 2; i <= Math.sqrt(n); i++) {
            if (n % i == 0) return false;
        }
        return true;
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new SoNguyenTo().setVisible(true);
        });
    }
}
